# Copy to .dev.vars for local `wrangler dev`. In production use Cloudflare encrypted secrets.
ADMIN_PASSWORD=replace-with-a-long-unique-password
META_ACCESS_TOKEN=replace-with-a-permanent-system-user-token
META_APP_SECRET=replace-with-your-meta-app-secret
META_VERIFY_TOKEN=replace-with-a-random-verification-token
SQUARE_ACCESS_TOKEN=replace-with-your-production-access-token
SQUARE_WEBHOOK_SIGNATURE_KEY=replace-with-your-webhook-signature-key

# Plaintext runtime variables.
ADMIN_USERNAME=admin
AUTO_ORDER_UPDATES_ENABLED=true
BUSINESS_TIME_ZONE=America/Toronto
MENU_URL=https://example.square.site
META_GRAPH_API_VERSION=v23.0
META_ORDER_TEMPLATE_LANGUAGE=en_US
META_ORDER_TEMPLATE_NAME=order_received_update
META_PHONE_NUMBER_ID=replace-with-your-phone-number-id
META_STATUS_TEMPLATE_LANGUAGE=en_US
META_STATUS_TEMPLATE_NAME=order_status_update
SQUARE_API_BASE_URL=https://connect.squareup.com
SQUARE_API_VERSION=2026-07-15
SQUARE_LOCATION_ID=replace-with-your-production-location-id
SQUARE_WEBHOOK_URL=https://your-worker.workers.dev/webhooks/square

# Optional customer-service responses.
ALLERGEN_INFO=
BUSINESS_HOURS=
DELIVERY_INFO=
PAYMENT_INFO=

